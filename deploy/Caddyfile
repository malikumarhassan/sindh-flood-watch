{
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 3MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    redir /api /api/ 308
    handle_path /api/* {
        reverse_proxy api:8000
    }
    handle {
        reverse_proxy web:3000
    }
}
