# Copy to .env.production in the repository root ON THE SERVER.
# Do not upload real secrets or this completed file into source control/chat.
DOMAIN=floodwatch.your-domain.example
ACME_EMAIL=your-certificate-contact@example.com
# Generate a URL-safe random password locally on the server; replace this value.
POSTGRES_PASSWORD=replace-me-with-a-long-random-url-safe-password
# Real view is the default; this does not connect an official feed.
PUBLIC_DEMO_MODE=false
ENABLE_REAL_NOTIFICATIONS=false
EXPO_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
